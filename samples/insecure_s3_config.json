{
  "_notice": "SYNTHETIC DEMONSTRATION ARTIFACT ONLY. NOT A REAL AWS RESOURCE OR ACCOUNT.",
  "configuration_type": "AWS::S3::Bucket",
  "metadata": {
    "resource_id": "synthetic-bucket-insecure-demo-01",
    "bucket_name": "synthetic-demo-unprotected-app-uploads",
    "region": "us-east-1",
    "environment": "synthetic-testing"
  },
  "configurations": {
    "public_access_block": {
      "block_public_acls": false,
      "ignore_public_acls": false,
      "block_public_policy": false,
      "restrict_public_buckets": false
    },
    "access_control_list": {
      "grants": [
        {
          "grantee": {
            "type": "Group",
            "uri": "http://acs.amazonaws.com/groups/global/AllUsers"
          },
          "permission": "READ"
        }
      ],
      "owner": {
        "display_name": "synthetic-admin",
        "id": "synthetic-owner-id-000000000001"
      }
    },
    "server_side_encryption": {
      "rules": []
    },
    "versioning": {
      "status": "Suspended",
      "mfa_delete": "Disabled"
    },
    "server_access_logging": {
      "enabled": false
    },
    "bucket_policy": {
      "version": "2012-10-17",
      "statement": [
        {
          "sid": "AllowPublicReadAll",
          "effect": "Allow",
          "principal": "*",
          "action": [
            "s3:GetObject"
          ],
          "resource": "arn:aws:s3:::synthetic-demo-unprotected-app-uploads/*"
        }
      ]
    },
    "object_lock": {
      "enabled": false
    }
  }
}
