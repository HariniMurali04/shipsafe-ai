# ==============================================================================
# ShipSafe AI - Environment Configuration Example
# NOTE: This file contains placeholder configuration ONLY.
# Do NOT store actual secrets, production credentials, or AWS keys here.
# ShipSafe AI does NOT require real AWS credentials to analyze synthetic configs.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Server Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated list for local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ==============================================================================
# Optional Amazon Bedrock AI Explanation Provider (Disabled by default)
# When BEDROCK_ENABLED=false, ShipSafe AI runs purely on the built-in, zero-cost
# deterministic explanation engine without making external network calls.
#
# PREREQUISITES FOR ENABLING:
# 1. An active AWS account with Amazon Bedrock access enabled in your region.
# 2. Model access granted for the specified model in AWS Bedrock Console.
# 3. IAM permissions: `bedrock:InvokeModel` on the target model ARN.
# 4. Standard AWS credentials configured via AWS CLI (aws configure) or IAM role.
# 5. Potential AWS API charges apply per token generated by Amazon Bedrock.
# ==============================================================================
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=400
BEDROCK_TEMPERATURE=0.0
BEDROCK_TIMEOUT_SECONDS=5.0
